<?xml version="1.0" encoding="UTF-8"?>

<Defs>

<!-- Syndicate Jugger Hardsuit -->

  <ThingDef ParentName="ArmorHelmetMakeableBase">
    <defName>Apparel_SyndicateJuggerHelmet</defName>
    <label>Syndicate Jugger helmet</label>
    <description>A modified version of the syndicate helmet, with super heavy armor. Property of the Gorlex Marauders.</description>
    <techLevel>Spacer</techLevel>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
      <researchPrerequisite>RS_JuggerHardsuit</researchPrerequisite>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>RS_SyndicateFabricationBench</li>
      </recipeUsers>
    </recipeMaker>
    <graphicData>
      <texPath>Helmets/SyndicateJuggerHelmet/SSHelm4</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <uiIconScale>1.25</uiIconScale>
    <tradeTags>
      <li>RS_SyndicateGear</li>
    </tradeTags>
    <generateCommonality>2</generateCommonality>
    <statBases>
      <WorkToMake>25000</WorkToMake>
      <MaxHitPoints>470</MaxHitPoints>
      <Mass>2</Mass>
      <Flammability>0.4</Flammability>
      <ArmorRating_Sharp>1.70</ArmorRating_Sharp>
      <ArmorRating_Blunt>1.05</ArmorRating_Blunt>
      <ArmorRating_Heat>1.40</ArmorRating_Heat>
      <Insulation_Cold>4</Insulation_Cold>
      <Insulation_Heat>2</Insulation_Heat>
      <EquipDelay>3</EquipDelay>
    </statBases>
    <costList>
      <ComponentSpacer>2</ComponentSpacer>
      <Plasteel>90</Plasteel>
      <DevilstrandCloth>85</DevilstrandCloth>
    </costList>
    <equippedStatOffsets>
      <ShootingAccuracyPawn>0.1</ShootingAccuracyPawn>
      <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.69</VacuumResistance>
    </equippedStatOffsets>
    <apparel>
      <tags>
        <li>RS_SyndicateGear</li>
      </tags>
      <bodyPartGroups>
        <li>FullHead</li>
      </bodyPartGroups>
      <wornGraphicPath>Helmets/SyndicateJuggerHelmet/SSHelm4</wornGraphicPath>
      <useWornGraphicMask>true</useWornGraphicMask>
      <layers>
        <li>Overhead</li>
      </layers>
      <defaultOutfitTags>
        <li>RS_SyndicateGear</li>
      </defaultOutfitTags>
      <useDeflectMetalEffect>true</useDeflectMetalEffect>
      <forceEyesVisibleForRotations>
        <li>1</li>
        <li>2</li>
        <li>3</li>
      </forceEyesVisibleForRotations>
    </apparel>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>10</weight>
          <only>(0.9,0.9,0.9,1)</only>
        </li>
        <li>
          <weight>10</weight>
          <only>(0.33,0.33,0.33,1)</only>
        </li>
        <li>
          <weight>10</weight>
          <only>(0.65,0.65,0.65,1)</only>
        </li>
        <li>
          <weight>6</weight>
          <min>(0.3,0.3,0.3,1)</min>
          <max>(0.5,0.5,0.5,1)</max>
        </li>
      </options>
    </colorGenerator>
    <comps>
      <li Class="CompProperties_Biocodable"/>
      <li Class="RimStation.Unlocker.CompProperties_RS_BiocodeUnlockerImmune"/>
    </comps>
    <thingSetMakerTags>
      <li>RewardStandardHighFreq</li>
    </thingSetMakerTags>
  </ThingDef>

  <ThingDef ParentName="ArmorMachineableBase">
