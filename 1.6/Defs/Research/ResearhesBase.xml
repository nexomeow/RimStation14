    <label>Black market basics</label>
    <description>Provides access to syndicate basics tech.</description>
    <tab>RS_Syndicate</tab> 
    <baseCost>1500</baseCost>
    <techLevel>Spacer</techLevel>
    <researchViewX>0</researchViewX>
    <researchViewY>2.5</researchViewY>
    <discoveredLetterTitle>Syndicate black market network</discoveredLetterTitle>
