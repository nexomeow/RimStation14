  <ThingDef ParentName="MeleeWeaponSyndicate">
    <defName>RS_MeleeWeapon_EnergySword</defName>
    <label>Energy sword</label>
    <description>A genuine plasma blade, originally developed long ago by the NanoTrasen Corporation. The technology was subsequently stolen by the Syndicate. However, it has since become so widespread across the Core Worlds that it is effectively considered common property—though such weapons remain a rare sight due to their high cost.</description>
    <soundInteract>RS_Interact_EnergySword</soundInteract>
    <meleeHitSound>RS_MeleeHit_EnergySword</meleeHitSound>
    <equippedAngleOffset>-25</equippedAngleOffset>
    <relicChance>5</relicChance>
    <smeltable>false</smeltable>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>4</glowRadius>
        <glowColor>(255, 0, 50, 255)</glowColor>
      </li>
    </comps>
    <weaponClasses>
      <li>MeleePiercer</li>
    </weaponClasses>
    <graphicData>
      <texPath>Weapons/Melee/esword</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.2, 1.2)</drawSize>
    </graphicData>
    <recipeMaker>
      <researchPrerequisite>RS_EnergyWeapons</researchPrerequisite>
      <skillRequirements>
        <Crafting>10</Crafting>
      </skillRequirements>
      <displayPriority>405</displayPriority>
    </recipeMaker>
    <statBases>
      <WorkToMake>55000</WorkToMake>
      <Mass>1</Mass>
    </statBases>
    <costList>
      <Plasteel>30</Plasteel>
      <Steel>30</Steel>
      <ComponentSpacer>3</ComponentSpacer>
      <RS_RedspaceCubeSpecial>1</RS_RedspaceCubeSpecial>
    </costList>
    <tools>
      <li>
        <label>point</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>25</power>
        <cooldownTime>2.6</cooldownTime>
        <extraMeleeDamages>
          <li>
            <def>Flame</def>
            <amount>10</amount>
            <chance>0.5</chance>
          </li>
        </extraMeleeDamages>
      </li>
      <li>
        <label>edge</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>31</power>
        <cooldownTime>2.6</cooldownTime>
        <extraMeleeDamages>
          <li>
            <def>Flame</def>
            <amount>10</amount>
            <chance>0.5</chance>
