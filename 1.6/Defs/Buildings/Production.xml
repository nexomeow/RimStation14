<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BuildingBase">
      <defName>RS_SyndicateMiningFarm</defName>
      <label>Redspace cubes mining farm</label>
      <description>It allows you to mine redspace cubes slowly, expensively, and with high energy consumption—which you can later use to trade on the Syndicate black market.</description>
      <graphicData>
        <texPath>Buildings/MiningFarm</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <shaderType>CutoutComplex</shaderType>
        <drawSize>(2,2)</drawSize>
        <damageData>
          <cornerTL>Damage/Corner</cornerTL>
          <cornerTR>Damage/Corner</cornerTR>
          <cornerBL>Damage/Corner</cornerBL>
          <cornerBR>Damage/Corner</cornerBR>
        </damageData>
      </graphicData>
      <!-- no i dont fucking want to draw more than one shitsprite for that thing -->
      <rotatable>false</rotatable>
      <size>(2,2)</size> 
      <tickerType>Normal</tickerType> 
      <designationCategory>RS_RimStation</designationCategory>
      <comps>
        <li Class="CompProperties_Power">
          <compClass>CompPowerTrader</compClass>
          <basePowerConsumption>2100</basePowerConsumption>
          <shortCircuitInRain>true</shortCircuitInRain>
        </li>
        <li Class="RimStation.MiningFarm.CompProperties_RS_RedspaceMiningFarm">
            <spawnIntervalTicks>120000</spawnIntervalTicks>
            <stackCount>5</stackCount>
        </li>
      </comps>
    <researchPrerequisites>
      <li>RS_MiningFarms</li>
    </researchPrerequisites>
  </ThingDef>

  <ThingDef ParentName="BenchBase">
    <defName>RS_SyndicateFabricationBench</defName>
    <label>syndicate fabrication bench</label>
    <description>A workbench equipped with advanced tools for producing syndicate technologies.</description>
    <thingClass>Building_WorkTable</thingClass>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <statBases>
      <MaxHitPoints>260</MaxHitPoints>
      <WorkToBuild>4500</WorkToBuild>
      <Flammability>1.0</Flammability>
    </statBases>
    <minifiedDef />
    <thingCategories Inherit="false" />
    <size>(5,2)</size>
    <costList>
      <Steel>250</Steel>
      <ComponentIndustrial>10</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
      <RS_RedspaceCubeSpecial>1</RS_RedspaceCubeSpecial>
    </costList>
    <comps>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>ToolCabinet</li>
        </linkableFacilities>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>320</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
    </comps>
    <!-- <recipes>
      <li>Make_ComponentIndustrial</li>
      <li>Make_ComponentSpacer</li>
    </recipes> -->
    <graphicData>
      <texPath>Buildings/SyndicateBench</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(7,4)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.20</staticSunShadowHeight>
    <designationCategory>RS_RimStation</designationCategory>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
      <workTableRoomRole>Workshop</workTableRoomRole>
      <workTableNotInRoomRoleFactor>0.8</workTableNotInRoomRoleFactor>
    </building>
    <fillPercent>0.5</fillPercent>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <hasInteractionCell>true</hasInteractionCell>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <uiOrder>2530</uiOrder>
    <surfaceType>Item</surfaceType>
    <designationHotKey>Misc12</designationHotKey>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>RS_SyndieCrafting</li>
    </researchPrerequisites>
  </ThingDef>

</Defs>
